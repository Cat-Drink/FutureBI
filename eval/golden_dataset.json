    "sql": "SELECT COUNT(f.order_id) AS order_count\nFROM fact_orders f\nWHERE f.pay_status = 'SUCCESS'\nLIMIT 100"
  },
  {
    "id": "Q08",
    "question": "2024年6月成功下单的去重用户数？",
    "scenario": "去重计数",
    "dsl": {
      "metrics": [
        {
          "kind": "aggregate",
          "field": "user_id",
          "agg": "count_distinct",
          "alias": "active_users"
        }
      ],
      "dimensions": [],
      "time_filter": {
        "granularity": "day",
        "range_type": "absolute",
        "absolute": {
          "start": "2024-06-01",
          "end": "2024-07-01"
        }
      },
      "filters": [
        {
          "field": "pay_status",
          "operator": "eq",
          "value": "SUCCESS"
        }
      ],
      "order_by": [],
      "limit": 100
    },
    "sql": "SELECT COUNT(DISTINCT f.user_id) AS active_users\nFROM fact_orders f\nWHERE f.pay_status = 'SUCCESS' AND f.order_time >= TIMESTAMP '2024-06-01 00:00:00' AND f.order_time < TIMESTAMP '2024-07-01 00:00:00'\nLIMIT 100"
  },
  {
    "id": "Q09",
    "question": "2024年6月成功订单的人均消费(ARPU)是多少？",
    "scenario": "比率指标 ARPU",
    "dsl": {
      "metrics": [
        {
          "kind": "ratio",
          "numerator": {
            "kind": "aggregate",
            "field": "order_amount",
            "agg": "sum",
            "alias": "gmv"
          },
          "denominator": {
            "kind": "aggregate",
            "field": "user_id",
            "agg": "count_distinct",
            "alias": "active_users"
          },
          "alias": "arpu"
        }
      ],
      "dimensions": [],
      "time_filter": {
        "granularity": "day",
        "range_type": "absolute",
        "absolute": {
          "start": "2024-06-01",
          "end": "2024-07-01"
        }
      },
      "filters": [
        {
          "field": "pay_status",
          "operator": "eq",
          "value": "SUCCESS"
        }
      ],
      "order_by": [],
      "limit": 100
    },
    "sql": "SELECT (SUM(f.order_amount)) / (COUNT(DISTINCT f.user_id)) AS arpu\nFROM fact_orders f\nWHERE f.pay_status = 'SUCCESS' AND f.order_time >= TIMESTAMP '2024-06-01 00:00:00' AND f.order_time < TIMESTAMP '2024-07-01 00:00:00'\nLIMIT 100"
  },
  {
    "id": "Q10",
    "question": "广东省或浙江省、订单金额100到5000元之间的各品类成功订单GMV？",
    "scenario": "in/between 操作符 + 维度",
    "dsl": {
      "metrics": [
        {
          "kind": "aggregate",
          "field": "order_amount",
          "agg": "sum",
          "alias": "gmv"
        }
      ],
      "dimensions": [
        {
          "field": "category"
        }
      ],
      "filters": [
        {
          "field": "pay_status",
          "operator": "eq",
          "value": "SUCCESS"
        },
        {
          "field": "province",
          "operator": "in",
          "value": [
            "广东",
            "浙江"
          ]
        },
        {
          "field": "order_amount",
          "operator": "between",
          "value": [
            100,
            5000
          ]
        }
      ],
      "order_by": [
        {
          "field": "gmv",
          "direction": "desc"
        }
      ],
      "limit": 100
    },
    "sql": "SELECT p.category AS category, SUM(f.order_amount) AS gmv\nFROM fact_orders f\nJOIN dim_user u ON u.user_id = f.user_id\nJOIN dim_product p ON p.product_id = f.product_id\nWHERE f.pay_status = 'SUCCESS' AND u.province IN ('广东', '浙江') AND f.order_amount BETWEEN 100.0 AND 5000.0\nGROUP BY p.category\nORDER BY gmv DESC\nLIMIT 100"
  }
]
