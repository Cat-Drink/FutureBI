# LLM 接入配置（Agent 自动读取；未配置则回退到确定性启发式 NL2DSL）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 审计与结构化日志（P0）
AUDIT_ENABLED=1
LOG_LEVEL=INFO

# SQL 执行层资源治理（P0/P1）
# 语句超时（毫秒）：超过则中断取消查询
QUERY_TIMEOUT_MS=30000
# 扫描行数上限：任一基表扫描超过即熔断拒绝执行
MAX_SCAN_ROWS=10000000
# 返回行数硬上限（LIMIT 硬上限熔断）
MAX_RESULT_ROWS=20000
# SQL 执行自愈最大重试次数（把精确引擎报错喂回 LLM 重写 DSL，至少 1 次）
SQL_SELF_HEAL_MAX_RETRIES=1
