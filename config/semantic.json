{
  "fact_table": "fact_orders",
  "fact_tables": ["fact_orders", "fact_refunds"],
  "aliases": {
    "fact_orders": "f",
    "fact_refunds": "r",
    "dim_user": "u",
    "dim_product": "p"
  },
  "fields": {
    "order_id": { "table": "fact_orders", "column": "order_id", "dtype": "int" },
    "user_id": { "table": "fact_orders", "column": "user_id", "dtype": "int" },
    "product_id": { "table": "fact_orders", "column": "product_id", "dtype": "int" },
    "order_amount": { "table": "fact_orders", "column": "order_amount", "dtype": "float" },
    "discount_amount": { "table": "fact_orders", "column": "discount_amount", "dtype": "float" },
    "pay_status": { "table": "fact_orders", "column": "pay_status", "dtype": "str" },
    "order_time": { "table": "fact_orders", "column": "order_time", "dtype": "timestamp" },
    "refund_id": { "table": "fact_refunds", "column": "refund_id", "dtype": "int" },
    "refund_amount": { "table": "fact_refunds", "column": "refund_amount", "dtype": "float" },
    "refund_time": { "table": "fact_refunds", "column": "refund_time", "dtype": "timestamp" },
    "refund_status": { "table": "fact_refunds", "column": "refund_status", "dtype": "str" },
    "province": { "table": "dim_user", "column": "province", "dtype": "str" },
    "gender": { "table": "dim_user", "column": "gender", "dtype": "str" },
    "register_time": { "table": "dim_user", "column": "register_time", "dtype": "timestamp" },
    "category": { "table": "dim_product", "column": "category", "dtype": "str" },
    "brand": { "table": "dim_product", "column": "brand", "dtype": "str" },
    "unit_price": { "table": "dim_product", "column": "unit_price", "dtype": "float" }
  },
  "join_rules": {
    "dim_user": { "type": "inner", "on": [["user_id", "user_id"]] },
    "dim_product": { "type": "inner", "on": [["product_id", "product_id"]] }
  },
  "fact_join_rules": {
    "fact_refunds": { "type": "left", "on": [["order_id", "order_id"]] }
  }
}
